# Copiez ce fichier en ".env" (déjà ignoré par Git si vous l'ajoutez au .gitignore),
# puis renseignez votre clé. Docker Compose lit automatiquement le fichier ".env".
GROQ_API_KEY=
# Vérifiez les modèles disponibles dans la console Groq : les noms évoluent.
GROQ_MODEL=openai/gpt-oss-20b
# low, medium ou high : propre aux modèles GPT OSS (laisser vide pour un autre modèle)
GROQ_REASONING_EFFORT=low
INSIGHTS_INTERVAL_SECONDS=900
